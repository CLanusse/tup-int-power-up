# Prototipo (entrega 1): la API se simula en el navegador con MSW.
# Poné false para usar un backend real en VITE_API_URL.
VITE_USE_MOCK_API=true

# Demora simulada de cada respuesta, en milisegundos.
VITE_MOCK_DELAY=300

# Opcional. Por defecto: <origen del frontend>/api
# VITE_API_URL=http://localhost:3001/api
